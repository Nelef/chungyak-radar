# ── 공공데이터포털 (data.go.kr) 발급 키 ─────────────────────────
# "한국부동산원_주택청약 분양정보 조회 서비스" 활용신청 후 일반 인증키(Decoding)
APPLYHOME_API_KEY=
# "한국토지주택공사_분양임대공고문 정보" 활용신청 후 일반 인증키(Decoding)
LH_API_KEY=

# ── 텔레그램 ────────────────────────────────────────────────
# @BotFather 로 봇 생성 후 토큰
TELEGRAM_BOT_TOKEN=
# 봇에게 아무 메시지 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
# (부부 둘 다 받으려면 둘이 함께 있는 그룹방을 만들고 그 그룹의 chat.id를 넣으면 됨)
TELEGRAM_CHAT_ID=

# ── 테스트 모드: 1이면 API 키 없이 샘플 데이터로 동작 확인 ──
MOCK=1

# ── 통근시간 계산 (목적지 기준, 선택사항) ──────────────────
# developers.kakao.com → 애플리케이션 추가 → REST API 키 (주소→좌표 변환용)
KAKAO_REST_KEY=
# lab.odsay.com → 회원가입 → API 키 발급 (대중교통 길찾기, 무료 1,000회/일)
ODSAY_API_KEY=

# ── 분양가/필요현금 계산 (선택) ──────────────────────────────
# aistudio.google.com 무료 키. 공고문 PDF를 Gemini가 읽어 계약금·중도금 조건 추출.
# 없으면 계약금 가정치(config)로 폴백. 무료 티어라 개인 사용엔 충분.
GEMINI_API_KEY=
